+import java.util.stream.Collectors;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class PluginFinderTest extends LlmAiCopilotTest {
+
+    private static String serializePlugins(List<PluginMetadata<Integer>> plugins) {
+        try {
+            Map<String, String> descriptionByType = plugins.stream()
+                .filter(plugin -> !plugin.deprecated())
+                .collect(Collectors.toMap(
+                    PluginMetadata::type,
+                    plugin -> plugin.description() == null ? "" : plugin.description(),
+                    (existing, ignored) -> existing
+                ));
